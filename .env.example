# Contrast — environment. Copy to `.env` and fill in the keys.
#
#   cp .env.example .env
#
# Everything else already has a working default. Keys are the only thing you
# should need to change to go from a fresh clone to a running install.
#
# An exported environment variable always beats the encrypted store, so `.env`
# is the override, not the source of truth. To keep a key encrypted at rest
# instead, leave it blank here and paste it into the dashboard's Settings tab —
# it lands in sessions/.secrets.json (AES-256-GCM) and never touches config.json.
# `.env` is gitignored.

# ---------------------------------------------------------------- AI providers

# Paid path: powers the vision and reasoning checks a rules engine cannot do.
# Without it, the pipeline still runs — it degrades to the free tier, then to
# deterministic-only, and says so on the report. It never silently skips.
# Models are set in config.json (ai.openaiModel / ai.openaiModelReasoning),
# NOT here — IDs churn and a hardcoded one goes stale.
OPENAI_API_KEY=

# Free path: the fallback tier, and what the AI-assess phase used first.
# Note: ai.tier in config.json defaults to "free", which prints a warning
# because Google may train on free-tier prompts. Set it to "paid" with a billed
# key before scanning any client's data.
GEMINI_API_KEY=

# ------------------------------------------------------------------- operating

# Hard monthly ceiling on paid-model spend, in USD. The budget ledger refuses a
# call that would cross it and degrades to the free tier instead. Set it lower
# than you think you need; nothing breaks when it is hit.
# Overrides ai.monthlyCeilingUsd in config.json.
# AI_MONTHLY_CEILING_USD=24

# Public scanner tuning. Defaults are in docker-compose.yml and are sane.
# PUBLIC_PORT=8080
# PUBLIC_MAX_PAGES=5
# PUBLIC_RATE_LIMIT=3
# PUBLIC_MAX_CONCURRENT=2
# PUBLIC_RUN_RETENTION_DAYS=15

# Where the login password lives (scrypt-hashed, then encrypted at rest).
# Set the password itself with: node src/cli.js set-password
# AUTH_DIR=auth

# ------------------------------------------------------------------- funding

# The support meter on the public pages. Bump as donations land and restart
# the public service — it is read per request, so no rebuild is needed.
# FUNDING_RAISED=0
# SUPPORT_URL=https://buymeacoffee.com/kafydier

# --------------------------------------------------------------------- vaults

# Optional: manage the encryption key for sessions/ and auth/ yourself instead
# of letting them generate one. 32 bytes, hex or base64.
# A11Y_SESSION_KEY=
